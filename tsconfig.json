{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "baseUrl": ".",
    "rootDir": ".",
    "paths": {
      "@zyd-labs/datatable-kit": ["./src"],
      "@zyd-labs/datatable-kit/*": ["./src/*"]
    }
  },
  "include": ["src/**/*", "vitest.config.ts"]
}
